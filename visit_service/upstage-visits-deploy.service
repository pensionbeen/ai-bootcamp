[Unit]
Description=Verify and deploy the Upstage visit logger from main
After=network-online.target docker.service k3s.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/upstage-bootcamp/visits/bin/deploy.sh
TimeoutStartSec=15min
TimeoutStopSec=3min
UMask=0077
Environment=GIT_TERMINAL_PROMPT=0
Nice=10
CPUWeight=20
IOWeight=20
